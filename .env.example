# ─── Venue Service — Environment Variables ───────────────────────────────────
# Copy to .env for local standalone development.
# In the integrated compose (stagepass-infrastructure), these are set directly
# in docker-compose.yml from the root .env file.
#
# RULE-14: Docker Compose auto-loads .env (not .env.local).
# Name this file exactly .env when using docker compose up without --env-file.
#
# Secrets (NEVER committed): all real values come from HashiCorp Vault.
# NFR-SEC-008.

PORT=8083
NODE_ENV=development

# MongoDB — single-node replica set required for transactions (Outbox pattern)
MONGODB_URI=mongodb://localhost:27017/venue?replicaSet=rs0&directConnection=true

# Kafka — use localhost:29092 for host-machine tools, kafka:9092 inside Docker (RULE-16)
KAFKA_BROKERS=localhost:29092

# Auth Service JWKS endpoint for RS256 token validation (local validation, no per-request call)
AUTH_JWKS_URI=http://localhost:8081/auth/jwks

# OpenTelemetry collector — use host.docker.internal:4318 inside Docker containers
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=venue-service
